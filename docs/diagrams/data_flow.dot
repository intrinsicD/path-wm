n17 [label="video output\n[1, 2, 3, 16, 16]", fillcolor="#fff0d9"];
n18 [label="Candidate action sequences\n[1, 2, 2, 2]", fillcolor="#e6f3ec"];
n19 [label="Goal image\n[1, 3, 16, 16]", fillcolor="#e6f3ec"];
n20 [label="plan_to_image\nPlan", fillcolor="#edf3fa"];
n21 [label="Selected action sequence\n[1, 2, 2]", fillcolor="#fff0d9"];
n0 -> n5 [style=solid];
