+
+## 39. Scope balanced two-time ranking to an explicit R1 training choice
+
+**Product and question.** ABI-v2 evidence for E1_common_base needs shared temporal content before
+belief bootstrap and H1 testing. Conditional on passing controlled-source R0 checkpoints, compare
+only the time-ranking component at the 2,000-update budget in DDR §38.
+
+**Interface.** Existing RepresentationLearner.loss and RepresentationBatch remain unchanged.
+`train.audiovisual_time_objective` accepts `current_anchor` (the omitted-key default) or
+`balanced_assignment`; an explicit key is valid only in stage `representation_av`. Unknown names
+fail closed. Model parameters, initialization order/RNG, representation config and data binding
+remain exact. No source validation is relaxed. The default uses the literal existing arithmetic.
+
+**Single intervention.** Keep current-time symmetric retrieval and every other loss/weight fixed.
+The candidate replaces the two current-anchor softplus terms with
+`softplus(-dot(v_t-v_s, a_t-a_s)/temperature)`, averaged over examples with unit embeddings.
+This supervises both aligned times. Swapping both times preserves ranking; swapping one modality
+reverses its margin; constant signals have log(2) ranking loss. The previous constructed current-
+anchor counterexample must receive a stronger penalty and a gradient toward correct assignment.
+
+**Essential tests and evaluation.** Before implementation, test scope/initialization and literal
+default compatibility, unchanged auxiliary losses/frozen teachers, and the counterexample plus
+assignment symmetries. Existing conformance tests cover the unchanged model contract. Full R1
+configs are bound to the final SHA-256 values only after both predeclared controlled R0 runs pass.
+No R1 continuation is authorized by a failed or partial R0 source, and no development result is H1.
+
+**Implementation status (not a GREEN experiment milestone).** The isolated implementation passes
+205 fast tests (two opt-in tests deselected). Cross-runtime replay on measured R0/R1 checkpoints
+confirms exact default losses, all parameter gradients and global/corruption RNG states on CPU.
+Both controlled 5,000-update R0 sources subsequently fail the same three original conditions:
+video/audio rank and video temporal retrieval. No R1 continuation or candidate panel is run.
+The loss stays in `dev/controlled-balanced-time`, pending a valid source and a full controlled
+number on the panel. Main retains the original runtime and the failed-source evidence. This
+is a prepared implementation, not evidence of an objective improvement or a promotion gate.
diff --git a/tests/unit/test_av_time_objective.py b/tests/unit/test_av_time_objective.py
new file mode 100644
index 0000000..cd43c59
--- /dev/null
+++ b/tests/unit/test_av_time_objective.py
@@ -0,0 +1,123 @@
+"""R1 timing supervision must see both aligned times without changing the R0 contract (DDR §39)."""
+from copy import deepcopy
+from pathlib import Path
+import math
+
+import pytest
+import torch
+import torch.nn.functional as F
+import yaml
+
+from contracts import RepresentationBatch, TemporalObservation
+from training.base_model import build_common_world_model
+from training.representation import build_representation_learner
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def _config(mode=None):
+    cfg = yaml.safe_load((ROOT / 'configs/dev/common_base_controlled_r0.yaml').read_text())
+    cfg['train']['stage'] = 'representation_av'
+    if mode is not None:
+        cfg['train']['audiovisual_time_objective'] = mode
+    return cfg
+
+
+def _learner(mode=None):
+    cfg = _config(mode)
+    torch.manual_seed(761)
+    model = build_representation_learner(cfg, build_common_world_model(cfg))
+    model.set_stage('representation_av')
+    return model
+
+
+def _batch():
+    generator = torch.Generator().manual_seed(762)
+    def observations():
+        return {
+            'video': TemporalObservation(
+                torch.randint(256, (2, 4, 3, 64, 64), generator=generator, dtype=torch.uint8),
+                torch.linspace(-.5, -.125, 4).expand(2, -1), torch.ones(2, 4, dtype=torch.bool)),
+            'audio': TemporalObservation(
+                torch.rand(2, 1, 2048, generator=generator) * 2 - 1,
+                torch.linspace(-.128, -1/16000, 2048).expand(2, -1), torch.ones(2, 2048, dtype=torch.bool)),
+        }
+    return RepresentationBatch(observations(), observations(), observations())
+
+
+def _loss(learner, batch):
+    return learner.loss(batch, stage='representation_av', generator=torch.Generator().manual_seed(763))
+
+
+def test_r1_choice_preserves_initialization_rng_and_all_other_objectives():
+    default = _learner()
+    rng = torch.get_rng_state().clone()
+    explicit = _learner('current_anchor')
+    balanced = _learner('balanced_assignment')
+    assert getattr(balanced, 'audiovisual_time_objective', None) == 'balanced_assignment', 'no implementation: R1-only timing choice'
+    assert torch.equal(rng, torch.get_rng_state())
+    for name, value in default.state_dict().items():
+        assert torch.equal(value, explicit.state_dict()[name])
+        assert torch.equal(value, balanced.state_dict()[name])
+    batch = _batch()
+    old, current, paired = (_loss(model, batch) for model in (default, explicit, balanced))
+    for name in old:
+        torch.testing.assert_close(old[name], current[name], rtol=0, atol=0)
+        if name not in ('audiovisual_sync', 'total'):
+            torch.testing.assert_close(old[name], paired[name], rtol=0, atol=0)
+    paired['total'].backward()
+    for modality in ('video', 'audio'):
+        assert any(p.grad is not None and p.grad.abs().sum() > 0 for p in balanced.core.encoders[modality].parameters())
+    assert all(p.grad is None for p in balanced.teachers.parameters())
+
+
+def test_r1_choice_rejects_unknown_names_and_cannot_be_set_for_r0():
+    cfg = _config('balanced_assignment')
+    cfg['train']['stage'] = 'representation_unimodal'
+    with pytest.raises(ValueError, match='R1|representation_av'):
+        build_representation_learner(cfg, build_common_world_model(cfg))
+    cfg = _config('misspelled')
+    with pytest.raises(ValueError, match='audiovisual_time_objective'):
+        build_representation_learner(cfg, build_common_world_model(cfg))
+    implicit = deepcopy(cfg)
+    implicit['train'].pop('audiovisual_time_objective')
+    implicit['train']['stage'] = 'representation_unimodal'
+    build_representation_learner(implicit, build_common_world_model(implicit))
+
+
+def test_balanced_loss_rejects_shifted_pair_disagreement_and_obeys_assignment_symmetry(monkeypatch):
+    current, balanced = _learner('current_anchor'), _learner('balanced_assignment')
+    assert getattr(balanced, 'audiovisual_time_objective', None) == 'balanced_assignment', 'no implementation: balanced assignment'
+    batch = _batch()
+    views = current.evaluation_views(batch, stage='representation_av', generator=torch.Generator().manual_seed(764))
+    basis = torch.eye(4)
+    v = a = basis[:2]
+    vs = .5 * v + math.sqrt(3) / 2 * basis[2:]
+    agreed, disagreed = vs.clone(), .5 * a - math.sqrt(3) / 2 * basis[2:]
+    def value(model, vv, aa, ss, tt):
+        supplied = {**views, 'av_current': {'video': vv, 'audio': aa}, 'av_shifted': {'video': ss, 'audio': tt}}
+        monkeypatch.setattr(model, 'evaluation_views', lambda *args, **kwargs: supplied)
+        return _loss(model, batch)['audiovisual_sync']
+    old_good, old_bad = value(current, v, a, vs, agreed), value(current, v, a, vs, disagreed)
+    torch.testing.assert_close(old_good, old_bad, rtol=0, atol=0)
+    good, bad = value(balanced, v, a, vs, agreed), value(balanced, v, a, vs, disagreed)
+    assert good < old_good < bad
+    temperature = balanced.audiovisual_temperature
+    def ranking(vv, aa, ss, tt):
+        logits = vv @ aa.T / temperature
+        labels = torch.arange(2)
+        retrieval = .5 * (F.cross_entropy(logits, labels) + F.cross_entropy(logits.T, labels))
+        return value(balanced, vv, aa, ss, tt) - retrieval
+    tied = ranking(v, a, v, a)
+    torch.testing.assert_close(tied, torch.tensor(math.log(2)))
+    aligned = ranking(v, a, vs, agreed)
+    torch.testing.assert_close(aligned, ranking(vs, agreed, v, a))
+    swapped = ranking(v, agreed, vs, a)
+    assert swapped > aligned
+    # Backprop through the adversarial shifted audio must increase the true assignment margin.
+    variable = disagreed.clone().requires_grad_(True)
+    loss = value(balanced, v, a, vs, variable)
+    gradient, = torch.autograd.grad(loss, variable)
+    before = ((v - vs) * (a - variable)).sum(-1).mean()
+    after = ((v - vs) * (a - (variable - .01 * gradient))).sum(-1).mean()
+    assert after > before
